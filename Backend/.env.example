# --- OpenAI (required for new cases and live turns; the demo seed works without it)
OPENAI_API_KEY=sk-...
CHAT_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# --- DynamoDB
AWS_REGION=us-east-1
DYNAMODB_TABLE=alibi-sessions
AUTO_CREATE_TABLE=true
# Local development with DynamoDB Local (docker compose up dynamodb):
DYNAMODB_ENDPOINT_URL=http://localhost:8001
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local
# For real AWS: delete DYNAMODB_ENDPOINT_URL and the two dummy keys, and use your normal AWS credentials.

# --- Pinecone (optional: without it, dropped messages are forgotten instead of archived)
PINECONE_API_KEY=
PINECONE_INDEX=alibi-cold-storage
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# --- Memory defaults (small budget so truncation shows up quickly)
DEFAULT_STRATEGY=fit_to_budget
DEFAULT_BUDGET_TOKENS=800
DEFAULT_LAST_N=8
RECALL_BUDGET_TOKENS=300
RECALL_TOP_K=4
